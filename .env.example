# ===== COPIA QUESTO FILE IN .env E COMPILA =====
# NON committare mai il file .env su Git!

# Helius RPC — https://helius.dev (piano free sufficiente per iniziare)
HELIUS_API_KEY=la_tua_chiave_helius

# Anthropic API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Chiave privata del wallet Solana in base58
# USA UN WALLET DEDICATO SOLO AL BOT con dentro solo i 100 EUR.
# Mai il tuo wallet principale.
WALLET_PRIVATE_KEY=

# paper = simulazione (default, consigliato) | live = soldi veri
BOT_MODE=paper

# Telegram — notifiche + comandi PARTI/PAUSA/STOP (opzionale)
# Setup: vedi l'intestazione di telegram_bot.py e lancia telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
