# ===== COPIA QUESTO FILE IN .env E COMPILA =====
# NON committare mai il file .env su Git!

# paper = simulazione senza rischio (DEFAULT) | live = soldi veri
# Lascia paper finché non hai qualche giorno di dati e hai controllato
# `python analizza_segnali.py`.
BOT_MODE=paper

# Helius RPC — https://helius.dev (piano free sufficiente)
# OBBLIGATORIA in modalità live: senza RPC il bot non può confermare le
# transazioni né leggere il saldo, e si rifiuta di partire.
HELIUS_API_KEY=

# Chiave privata del wallet Solana in base58.
# USA UN WALLET DEDICATO con dentro solo il capitale che sei disposto a perdere.
# Mai il tuo wallet principale.
WALLET_PRIVATE_KEY=

# Chiave PUBBLICA attesa dello stesso wallet (indirizzo, non segreta).
# Il bot la confronta con la pubkey derivata da WALLET_PRIVATE_KEY all'avvio:
# se non combaciano te lo segnala subito invece di operare sul wallet sbagliato.
WALLET_PUBLIC_KEY=

# Telegram — notifiche + comandi PARTI/PAUSA/STOP (opzionale)
# Setup: vedi l'intestazione di telegram_bot.py, poi lancia telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- OPZIONALE: API key Jupiter ----
# Il piano gratuito (lite-api, senza chiave) concede 60 richieste al minuto in
# tutto, ed è ufficialmente deprecato. Le cadenze di default in config.py
# stanno dentro quel budget, ma è il vincolo che limita la frequenza del bot.
# Con una API key Jupiter decommenta la riga qui sotto e alza
# `limite_jupiter_al_minuto` in config.py.
# JUPITER_BASE_URL=https://api.jup.ag
