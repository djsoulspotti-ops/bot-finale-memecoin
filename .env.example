# ===== COPIA QUESTO FILE IN .env E COMPILA =====
# NON committare mai il file .env su Git!

# Helius RPC — https://helius.dev (piano free sufficiente per iniziare)
HELIUS_API_KEY=la_tua_chiave_helius

# Chiave privata del wallet Solana in base58
# USA UN WALLET DEDICATO SOLO AL BOT con dentro solo i 100 EUR.
# Mai il tuo wallet principale.
WALLET_PRIVATE_KEY=

# Chiave PUBBLICA attesa dello stesso wallet (indirizzo, non segreta).
# Il bot la confronta con la pubkey derivata da WALLET_PRIVATE_KEY all'avvio:
# se non combaciano, vuol dire che la chiave privata è sbagliata/di un altro
# wallet e il bot te lo segnala subito invece di operare sul wallet sbagliato.
WALLET_PUBLIC_KEY=AygVYH29YGw4UytXmdynNhSzkdCocJf38JJwbJBuvjXb

# live = soldi veri, opera col saldo reale del wallet (default) | paper = simulazione
BOT_MODE=live

# Telegram — notifiche + comandi PARTI/PAUSA/STOP (opzionale)
# Setup: vedi l'intestazione di telegram_bot.py e lancia telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
